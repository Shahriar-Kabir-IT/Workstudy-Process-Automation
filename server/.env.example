# ---- Work Study API configuration ----
# Point this at your PostgreSQL server (the DB host).
DATABASE_URL=postgresql://workstudy:CHANGE_ME@DB_HOST:5432/workstudy
PG_POOL_MAX=10
PG_SSL=false            # set true if the DB requires SSL (managed Postgres)

API_PORT=4000
NODE_ENV=production
# Comma-separated list of allowed web origins (the app server URL)
CORS_ORIGIN=http://localhost:5190

# ---- Auth ----
# Strong random secret used to sign login tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start if this is missing or shorter than 16 chars.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES=8h
# Optional: set ONE shared password for all seeded users (otherwise each gets a random one)
# SEED_PASSWORD=
